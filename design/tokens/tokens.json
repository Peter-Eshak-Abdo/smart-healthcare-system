        "700": { "$type": "color", "$value": "#B45309" },
        "800": { "$type": "color", "$value": "#92400E" },
        "950": { "$type": "color", "$value": "#451A03" }
      },
      "yellow": {
        "50": { "$type": "color", "$value": "#FEFCE8" },
        "200": { "$type": "color", "$value": "#FEF08A" },
        "400": { "$type": "color", "$value": "#FACC15" },
        "700": { "$type": "color", "$value": "#A16207" },
        "800": { "$type": "color", "$value": "#854D0E" },
        "950": { "$type": "color", "$value": "#422006" }
      },
      "green": {
        "50": { "$type": "color", "$value": "#F0FDF4" },
        "200": { "$type": "color", "$value": "#BBF7D0" },
        "400": { "$type": "color", "$value": "#4ADE80" },
        "700": { "$type": "color", "$value": "#15803D" },
        "800": { "$type": "color", "$value": "#166534" },
        "950": { "$type": "color", "$value": "#052E16" }
      },
      "sky": {
        "50": { "$type": "color", "$value": "#F0F9FF" },
        "200": { "$type": "color", "$value": "#BAE6FD" },
        "400": { "$type": "color", "$value": "#38BDF8" },
        "700": { "$type": "color", "$value": "#0369A1" },
        "800": { "$type": "color", "$value": "#075985" },
        "950": { "$type": "color", "$value": "#082F49" }
      },
      "violet": {
        "50": { "$type": "color", "$value": "#F5F3FF" },
        "200": { "$type": "color", "$value": "#DDD6FE" },
        "400": { "$type": "color", "$value": "#A78BFA" },
        "600": { "$type": "color", "$value": "#7C3AED" },
        "700": { "$type": "color", "$value": "#6D28D9" },
        "800": { "$type": "color", "$value": "#5B21B6" },
        "950": { "$type": "color", "$value": "#2E1065" }
      },
      "gray": {
        "50": { "$type": "color", "$value": "#F9FAFB" },
        "100": { "$type": "color", "$value": "#F3F4F6" },
        "200": { "$type": "color", "$value": "#E5E7EB" },
        "300": { "$type": "color", "$value": "#D1D5DB" },
        "400": { "$type": "color", "$value": "#9CA3AF" },
        "500": { "$type": "color", "$value": "#6B7280" },
        "600": { "$type": "color", "$value": "#4B5563" },
        "700": { "$type": "color", "$value": "#374151" },
        "800": { "$type": "color", "$value": "#1F2937" },
        "900": { "$type": "color", "$value": "#111827" }
      },
      "slate": {
        "input": { "$type": "color", "$value": "#7B8494" }
      }
    },
    "semantic": {
      "background": {
        "$type": "color",
        "$value": "#F3F4F6",
        "$extensions": { "mode": { "dark": "#0B1220", "emergency": "#000000", "sunlight": "#FFFFFF" } }
      },
      "foreground": {
        "$type": "color",
        "$value": "#111827",
        "$extensions": { "mode": { "dark": "#F9FAFB", "emergency": "#FFFFFF", "sunlight": "#000000" } }
      },
      "card": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$extensions": { "mode": { "dark": "#111827", "emergency": "#1C1C1E", "sunlight": "#FFFFFF" } }
      },
      "primary": {
        "$type": "color",
        "$value": "#2563EB",
        "$extensions": { "mode": { "dark": "#60A5FA", "emergency": "#FFFFFF", "sunlight": "#0040C1" } }
      },
      "primaryForeground": {
        "$type": "color",
        "$value": "#FFFFFF",
        "$extensions": { "mode": { "dark": "#0B1220", "emergency": "#000000", "sunlight": "#FFFFFF" } }
      },
      "danger": {
        "$type": "color",
        "$value": "#DC2626",
        "$extensions": { "mode": { "dark": "#F87171", "emergency": "#FF3B30", "sunlight": "#B00020" } }
      },
      "warning": {
        "$type": "color",
        "$value": "#B45309",
        "$extensions": { "mode": { "dark": "#FBBF24", "emergency": "#FFD60A", "sunlight": "#000000" } }
      },
      "caution": {
        "$type": "color",
        "$value": "#A16207",
        "$extensions": { "mode": { "dark": "#FACC15", "emergency": "#FFD60A", "sunlight": "#000000" } }
      },
      "success": {
        "$type": "color",
        "$value": "#15803D",
        "$extensions": { "mode": { "dark": "#4ADE80", "emergency": "#30D158", "sunlight": "#006B2D" } }
      },
      "info": {
        "$type": "color",
        "$value": "#0369A1",
        "$extensions": { "mode": { "dark": "#38BDF8", "emergency": "#0A84FF", "sunlight": "#0040C1" } }
      },
      "ai": {
        "$type": "color",
        "$value": "#6D28D9",
        "$extensions": { "mode": { "dark": "#A78BFA", "emergency": "#FFFFFF", "sunlight": "#5B21B6" } }
      }
    }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "12px" },
    "xl": { "$type": "dimension", "$value": "16px" },
    "2xl": { "$type": "dimension", "$value": "20px" },
    "3xl": { "$type": "dimension", "$value": "28px" }
  },
  "font": {
    "family": {
      "arabicDisplay": { "$type": "fontFamily", "$value": ["Cairo", "IBM Plex Sans Arabic", "sans-serif"] },
      "arabicBody": { "$type": "fontFamily", "$value": ["IBM Plex Sans Arabic", "Cairo", "sans-serif"] },
      "latin": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    }
  }
}
