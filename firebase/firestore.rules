rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // SmartHealth Zero-Trust Security Architecture — Assumed Data Model
    // =========================================================================
    //
    // Architecture invariant:
    //   All domain writes, Tier-3 AES-256-GCM field encryption (*_enc), Ed25519
    //   prescription signing, atomic pharmacy dispensing locks, break-glass
    //   emergency sessions, and SHA-256 hash-chained audit logs (system_logs)
    //   are executed strictly server-side by `backend-api` via `firebase-admin`
    //   (Admin SDK bypasses security rules).
    //
    // Firebase Auth Custom Claims (set exclusively by `backend-api` / Admin SDK):
    //   - role:          'patient' | 'doctor' | 'pharmacist' | 'paramedic' | 'admin'
    //   - status:        'active' | 'pending_verification' | 'suspended' | 'deactivated'
    //   - licenseStatus: 'verified' | 'pending' | 'suspended' | 'revoked' | 'expired' (clinical staff)
    //   - facilityId:    string (optional active facility UUID)
    //
    // Collections:
    //
    // 1. users/{userId}
    //    Document ID: Firebase Auth UID (UUID)
    //    Access: Active owner `get` only; `list` and all client writes denied.
    //    Fields:
    //      - uid: string (required, immutable, == userId, 1..128 chars)
    //      - role: string (required, immutable by client, enum app_role)
    //      - status: string (required, immutable by client, enum account_status)
    //      - session_epoch: int (required, >= 1, immutable by client)
    //      - full_name: string (required, 2..120 chars)
    //      - email: string (optional, valid email, <= 254 chars)
    //      - phone: string (optional, 6..24 chars)
    //      - preferred_locale: string (required, 'ar' | 'en')
    //      - created_at: timestamp (required, immutable)
    //      - updated_at: timestamp (required)
    //
    // 2. patients/{patientId}
    //    Document ID: Firebase Auth UID (UUID)
    //    Access: Active patient owner `get` only; `list` and all client writes denied.
    //    Fields:
    //      - uid: string (required, immutable, == patientId, 1..128 chars)
    //      - mrn: string (required, immutable, 4..64 chars)
    //      - national_id_bidx: string (optional, HMAC blind index, <= 128 chars)
    //      - national_id_enc: string (optional, AES-256-GCM ciphertext, <= 2048 chars)
    //      - blood_type: string (required, enum blood_type)
    //      - sex: string (required, enum sex)
    //      - onboarded: bool (required)
    //      - is_minor: bool (required)
    //      - created_at: timestamp (required, immutable)
    //      - updated_at: timestamp (required)
    //
    // 3. doctors/{id}, pharmacists/{id}, paramedics/{id}, practitioners/{id}
    //    Document ID: Firebase Auth UID (UUID)
    //    Access: Active role-matched owner `get` only; `list` and all client writes denied.
    //    Fields:
    //      - uid: string (required, immutable, == id, 1..128 chars)
    //      - practitioner_type: string (required, 'doctor' | 'pharmacist' | 'paramedic')
    //      - license_number: string (required, 2..64 chars)
    //      - license_status: string (required, enum license_status)
    //      - license_expires_at: timestamp (optional)
    //      - specialty_code: string (optional, 1..32 chars)
    //      - facility_ids: list<string> (optional, max 20 items)
    //      - created_at: timestamp (required, immutable)
    //      - updated_at: timestamp (required)
    //
    // 4. Reference Catalogs (read-only for active signed-in users):
    //    - facilities/{id}: hospital/clinic/pharmacy/ambulance_service metadata
    //    - drug_reference/{id}: canonical medication catalog
    //    - drug_interactions/{id}: deterministic DDI rules (DDInter 2.0 / curated)
    //    - icd10_reference/{id}: ICD-10 diagnosis codes
    //    - allergens_reference/{id}: coded allergens & cross-reactivity classes
    //    Access: Active authenticated `get` & `list`; all client writes denied.
    //
    // 5. prescriptions/{id} & emergency_contacts/{id}
    //    Document ID: UUID
    //    Access: Active patient owner `get` only (resource.data.patient_id == uid);
    //            `list` and all client writes denied.
    //    prescriptions fields:
    //      - id: string (required, immutable, 1..128 chars)
    //      - rx_number: string (required, immutable, 4..64 chars)
    //      - patient_id: string (required, immutable, 1..128 chars)
    //      - doctor_id: string (required, immutable, 1..128 chars)
    //      - facility_id: string (required, immutable, 1..128 chars)
    //      - status: string (required, enum prescription_status)
    //      - signature_b64: string (required, immutable, 32..512 chars)
    //      - issued_at: timestamp (required, immutable)
    //      - expires_at: timestamp (required, immutable)
    //    emergency_contacts fields:
    //      - id: string (required, immutable, 1..128 chars)
    //      - patient_id: string (required, immutable, 1..128 chars)
    //      - name: string (required, 1..120 chars)
    //      - relationship: string (required, 1..60 chars)
    //      - phone_enc: string (optional, AES-256-GCM ciphertext, <= 1024 chars)
    //      - priority: int (required, 1..10)
    //      - created_at: timestamp (required, immutable)
    //      - updated_at: timestamp (required)
    //
    // 6. Strictly Backend-Mediated Collections (ALL client reads & writes denied):
    //    - medical_records/{id}       (Tier-3 encrypted clinical records)
    //    - encounters/{id}            (Clinical visits & encrypted notes)
    //    - prescription_items/{id}    (Signed prescription lines & quantities)
    //    - dispensations/{id}         (Atomic dispensing records)
    //    - biometric_templates/{id}   (Orthogonal 512-d face templates — NEVER client-readable)
    //    - access_grants/{id}         (Patient -> practitioner authorization)
    //    - emergency_sessions/{id}    (Break-glass emergency sessions)
    //    - idempotency_keys/{id}      (Request idempotency locks)
    //    - outbox_events/{id}         (Transactional outbox queue)
    //    - security_flags/{id}        (Anomaly & abuse flags)
    //    - pending_approvals/{id}     (Two-person admin approvals)
    //    - share_codes/{id}           (Short-lived HMAC share codes)
    //    - verify_sessions/{id}       (Pharmacy verification context)
    //    - dispense_leases/{id}       (Soft 5-minute pharmacy preparation leases)
    //    - assistant_sessions/{id}    (AI triage & encrypted chat sessions)
    //    - notifications/{id}         (Notification dispatch outbox)
    //    - system_logs/{id}           (Immutable SHA-256 hash-chained audit trail)
    //
    // =========================================================================

    // =========================================================================
    // Helper Functions
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null
        && request.auth.uid is string
        && request.auth.uid.size() > 0;
    }

    function isNonAnonymous() {
      return !('firebase' in request.auth.token)
        || !('sign_in_provider' in request.auth.token.firebase)
        || request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Require email_verified == true whenever email or email_verified is present
    // in the token; blocks unverified email accounts while supporting custom/phone tokens.
    function isEmailVerified() {
      return (!('email' in request.auth.token)
          || ('email_verified' in request.auth.token && request.auth.token.email_verified == true))
        && (!('email_verified' in request.auth.token)
          || request.auth.token.email_verified == true);
    }

    function hasValidActiveAccount() {
      return isAuthenticated()
        && isNonAnonymous()
        && isEmailVerified()
        && 'role' in request.auth.token
        && request.auth.token.role is string
        && request.auth.token.role in ['patient', 'doctor', 'pharmacist', 'paramedic', 'admin']
        && 'status' in request.auth.token
        && request.auth.token.status == 'active';
    }

    function hasRole(role) {
      return hasValidActiveAccount() && request.auth.token.role == role;
    }

    function isClinicalStaff() {
      return hasValidActiveAccount()
        && request.auth.token.role in ['doctor', 'pharmacist', 'paramedic'];
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isActiveOwner(userId) {
      return hasValidActiveAccount() && isOwner(userId);
    }

    function isPatientDocOwner() {
      return hasValidActiveAccount()
        && resource != null
        && 'patient_id' in resource.data
        && resource.data.patient_id is string
        && resource.data.patient_id == request.auth.uid;
    }

    // =========================================================================
    // Identity & Profile Collections (Owner `get` only; zero list/write)
    // =========================================================================

    match /users/{userId} {
      allow get: if isActiveOwner(userId);
      allow list, create, update, delete: if false;
    }

    match /patients/{patientId} {
      allow get: if isActiveOwner(patientId) && hasRole('patient');
      allow list, create, update, delete: if false;
    }

    match /doctors/{doctorId} {
      allow get: if isActiveOwner(doctorId) && hasRole('doctor');
      allow list, create, update, delete: if false;
    }

    match /pharmacists/{pharmacistId} {
      allow get: if isActiveOwner(pharmacistId) && hasRole('pharmacist');
      allow list, create, update, delete: if false;
    }

    match /paramedics/{paramedicId} {
      allow get: if isActiveOwner(paramedicId) && hasRole('paramedic');
      allow list, create, update, delete: if false;
    }

    match /practitioners/{practitionerId} {
      allow get: if isActiveOwner(practitionerId) && isClinicalStaff();
      allow list, create, update, delete: if false;
    }

    // =========================================================================
    // Public Reference Catalogs (Active signed-in read-only; zero client write)
    // =========================================================================

    match /facilities/{facilityId} {
      allow read: if hasValidActiveAccount();
      allow write: if false;
    }

    match /drug_reference/{drugId} {
      allow read: if hasValidActiveAccount();
      allow write: if false;
    }

    match /drug_interactions/{interactionId} {
      allow read: if hasValidActiveAccount();
      allow write: if false;
    }

    match /icd10_reference/{codeId} {
      allow read: if hasValidActiveAccount();
      allow write: if false;
    }

    match /allergens_reference/{allergenId} {
      allow read: if hasValidActiveAccount();
      allow write: if false;
    }

    // =========================================================================
    // Patient-Owned Read-Only Clinical Headers (`get` by patient owner only)
    // =========================================================================

    match /prescriptions/{prescriptionId} {
      allow get: if hasValidActiveAccount()
        && hasRole('patient')
        && isPatientDocOwner();
      allow list, create, update, delete: if false;
    }

    match /emergency_contacts/{contactId} {
      allow get: if hasValidActiveAccount()
        && hasRole('patient')
        && isPatientDocOwner();
      allow list, create, update, delete: if false;
    }

    // =========================================================================
    // Strictly Backend-Mediated Clinical, Biometric & Operational Collections
    // =========================================================================

    match /medical_records/{recordId} {
      allow read, write: if false;
    }

    match /encounters/{encounterId} {
      allow read, write: if false;
    }

    match /prescription_items/{itemId} {
      allow read, write: if false;
    }

    match /dispensations/{dispensationId} {
      allow read, write: if false;
    }

    match /biometric_templates/{templateId} {
      allow read, write: if false;
    }

    match /access_grants/{grantId} {
      allow read, write: if false;
    }

    match /emergency_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /idempotency_keys/{keyId} {
      allow read, write: if false;
    }

    match /outbox_events/{eventId} {
      allow read, write: if false;
    }

    match /security_flags/{flagId} {
      allow read, write: if false;
    }

    match /pending_approvals/{approvalId} {
      allow read, write: if false;
    }

    match /share_codes/{codeId} {
      allow read, write: if false;
    }

    match /verify_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /dispense_leases/{leaseId} {
      allow read, write: if false;
    }

    match /assistant_sessions/{sessionId} {
      allow read, write: if false;
    }

    match /notifications/{notificationId} {
      allow read, write: if false;
    }

    // Immutable SHA-256 hash-chained audit trail — zero client read or write.
    match /system_logs/{logId} {
      allow read, write: if false;
    }

    // =========================================================================
    // Default Catch-All Deny Rule
    // =========================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
