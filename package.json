{
  "name": "smarthealth",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "contracts:openapi": "pnpm --filter @smarthealth/contracts openapi",
    "contracts:check": "pnpm --filter @smarthealth/contracts check",
    "tokens:build": "node scripts/tokens-build.mjs",
    "tokens:contrast": "node scripts/tokens-contrast.mjs",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "keys:dev": "pnpm --filter backend-api keys:dev",
    "seed:dev": "pnpm --filter backend-api seed:dev",
    "db:reset": "supabase db reset",
    "db:test": "bash supabase/tests/run.sh"
  }
}
