{
  "name": "smarthealth",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "backend-api",
    "web-admin"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w @smarthealth/contracts && npm run build -w backend-api && npm run build -w web-admin",
    "build:backend": "npm run build -w @smarthealth/contracts && npm run build -w backend-api",
    "contracts:openapi": "npm run openapi -w @smarthealth/contracts",
    "contracts:check": "npm run check -w @smarthealth/contracts",
    "tokens:build": "node scripts/tokens-build.mjs",
    "tokens:contrast": "node scripts/tokens-contrast.mjs",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "keys:dev": "npm run keys:dev -w backend-api",
    "seed:firebase": "npm run seed:firebase -w backend-api",
    "dev:backend": "npm run dev -w backend-api",
    "dev:web": "npm run dev -w web-admin"
  }
}
