# ==============================================================================
# SmartHealth — Master Environment Variables Template (ZERO REAL SECRETS)
# سمارت هيلث — نموذج متغيرات البيئة (لا تضع مفاتيح حقيقية في هذا الملف أبداً)
# ==============================================================================
# How to use / طريقة الاستخدام:
# 1. Copy the "BACKEND API" block into backend-api/.env
# 2. Copy the "WEB ADMIN" block into web-admin/.env.local
# 3. Copy the "AI SERVICE" block into ai-service/.env
# 4. Run `npm run keys:dev` in the repository root to auto-generate cryptographic
#    Ed25519 + AES-256 keys, then paste the matching keys below.
# ==============================================================================


# ==============================================================================
# 1. BACKEND API (copy into: backend-api/.env) — Render Free Web Service
# ==============================================================================
# Environment mode: local | test | staging | production
APP_ENV=local
# HTTP bind port locally (Render automatically sets PORT=10000 in production)
PORT=4000
# Semantic version & build SHA returned on GET /health
APP_VERSION=1.0.0
GIT_COMMIT=dev
# Allowed CORS origin for Next.js Web Admin (production example: https://smarthealth.vercel.app)
WEB_ORIGIN=http://localhost:3000

# --- Firebase Admin SDK (Firestore + Auth Custom Claims + Storage) ---
# بالعربي: بيانات حساب الخدمة من Firebase Console -> Project Settings -> Service accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Keep \n escaped inside double quotes on one line!
# ملاحظة مهمة: اترك \n داخل علامات التنصيص في سطر واحد
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# Optional alternative to the 3 fields above (single-line JSON of service account):
# FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app

# --- Upstash Redis (Free Tier — Rate Limiting & Idempotency Locks) ---
# Use either UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN (HTTPS REST) OR REDIS_URL (rediss://...)
# Optional locally (backend uses in-memory fallback when empty); recommended in production
# بالعربي: بيانات Redis من Upstash المجاني (اختياري محلياً ومهم في الإنتاج)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=

# --- Field-Level Encryption (AES-256-GCM Tier-3 PHI) & HMAC Blind Index ---
# Generate 32-byte base64 keys with `npm run keys:dev` or Node: crypto.randomBytes(32).toString('base64')
KEK_CURRENT_ID=k1
KEK_K1=REPLACE_WITH_32_BYTE_BASE64_KEY_FROM_KEYS_DEV
# Optional rotation key when migrating to k2:
# KEK_K2=
BLIND_INDEX_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY_FROM_KEYS_DEV

# --- Ed25519 Signing Keys (E-Prescriptions `SH1.`, Emergency Cards `SHEC1.`, Internal AI JWT) ---
# Generated automatically by `npm run keys:dev`
RX_SIGNING_KEY_ID=rx-2026-11
RX_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_ED25519_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

EMERGENCY_CARD_SIGNING_KEY_ID=ec-2026-11
EMERGENCY_CARD_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_ED25519_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Internal service-to-service EdDSA JWT private key (paired with INTERNAL_JWT_PUBLIC_KEY in ai-service)
INTERNAL_JWT_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_ED25519_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# --- AI Microservice & Biometric Thresholds ---
# Local: http://127.0.0.1:8000 | Production (HF Spaces): https://your-user-smarthealth-ai.hf.space
AI_SERVICE_URL=http://127.0.0.1:8000
FACE_MATCH_ACCEPT=0.50
FACE_MATCH_POSSIBLE=0.40
FACE_MATCH_MARGIN=0.08

# --- Minimum Client Versions & Feature Flags ---
MIN_CLIENT_VERSION_ANDROID=1.0.0
MIN_CLIENT_VERSION_IOS=1.0.0
MIN_CLIENT_VERSION_WEB=1.0.0
EMERGENCY_PHONE=123
FEATURE_ER_INTAKE=true
FEATURE_PASSKEY=false


# ==============================================================================
# 2. WEB ADMIN (copy into: web-admin/.env.local) — Vercel Free Hobby Tier
# ==============================================================================
# Public API URL pointing to backend-api (local: http://localhost:4000 | prod: https://smarthealth-backend-api.onrender.com)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_APP_VERSION=1.0.0

# --- Firebase Web Client Config (safe public client keys from Firebase Web App settings) ---
# بالعربي: بيانات تطبيق الويب من Firebase Console -> Project Settings -> Your apps (Web)
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:replacewithappid

# --- Server-side Firebase Admin Verification (for Next.js /api/auth/session cookie minting) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"


# ==============================================================================
# 3. AI SERVICE (copy into: ai-service/.env) — Hugging Face Spaces Free Docker
# ==============================================================================
APP_ENV=local
APP_VERSION=1.0.0
# Must match the public key corresponding to backend-api INTERNAL_JWT_SIGNING_KEY
# بالعربي: المفتاح العام المطابق لمفتاح INTERNAL_JWT_SIGNING_KEY في السيرفر
INTERNAL_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_ED25519_PUBLIC_KEY\n-----END PUBLIC KEY-----\n"

# Biometric orthogonal projection seeds (keep strictly secret & constant once patients enroll faces!)
# بالعربي: بذور تشفير بصمة الوجه — لا تغيّرها بعد تسجيل المرضى وإلا ستحتاج لإعادة تسجيل الوجوه
FACE_TRANSFORM_KEY_VERSION=1
FACE_TRANSFORM_SEED_1=REPLACE_WITH_RANDOM_HEX_OR_SECRET_SEED_1
FACE_TRANSFORM_SEED_2=REPLACE_WITH_RANDOM_HEX_OR_SECRET_SEED_2

# Liveness & image quality thresholds
LIVENESS_THRESHOLD=0.80
QUALITY_MIN_ENROLL=0.50
QUALITY_MIN_IDENTIFY=0.35

# ONNX Face/PAD model directory & SHA-256 verification (set VERIFY_MODEL_CHECKSUMS=true when models/ is populated)
MODELS_DIR=models
VERIFY_MODEL_CHECKSUMS=false
RED_FLAGS_PATH=red-flags.yaml
DATASET_VERSION=seed-2026-11
ENGINE_VERSION=rules-2026.11.1
EMERGENCY_PHONE_NUMBER=123

# Optional HTTPS JSON snapshot URL to refresh reference DDI/drugs rules periodically
REFDATA_SNAPSHOT_URL=

# AI Assistant LLM Provider: mock (local zero-cost default) | gemini | openai_compatible
# بالعربي: لإستخدام Gemini المجاني أو API متوافق مع OpenAI غيّر LLM_PROVIDER و أضف المفتاح
LLM_PROVIDER=mock
LLM_MODEL=mock
LLM_API_KEY=
LLM_BASE_URL=


# ==============================================================================
# 4. FLUTTER 6-PLATFORM APP (--dart-define flags when building/running mobile-app)
# ==============================================================================
# Pass these at build/run time, e.g.:
#   flutter build web --release \
#     --dart-define=API_BASE_URL=https://smarthealth-backend-api.onrender.com \
#     --dart-define=FIREBASE_API_KEY=... \
#     --dart-define=FIREBASE_APP_ID=... \
#     --dart-define=FIREBASE_MESSAGING_SENDER_ID=... \
#     --dart-define=FIREBASE_PROJECT_ID=... \
#     --dart-define=ANDROID_APK_DOWNLOAD_URL=/downloads/smarthealth.apk
#
# Mobile-app compile-time defines reference:
#   API_BASE_URL=https://smarthealth-backend-api.onrender.com
#   FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_OR_MOBILE_API_KEY
#   FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_APP_ID
#   FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_SENDER_ID
#   FIREBASE_PROJECT_ID=your-firebase-project-id
#   FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
#   FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
#   ANDROID_APK_DOWNLOAD_URL=/downloads/smarthealth.apk


# ==============================================================================
# 5. GITHUB ACTIONS / CI-CD SECRETS (configure in GitHub Repo Settings -> Secrets)
# ==============================================================================
#   FIREBASE_SERVICE_ACCOUNT_STAGING   -> Full JSON of Firebase service account (staging)
#   FIREBASE_PROJECT_ID_STAGING        -> Firebase project ID (staging)
#   RENDER_DEPLOY_HOOK_STAGING         -> Render Deploy Hook URL from Render dashboard
#   FIREBASE_SERVICE_ACCOUNT_PROD      -> Full JSON of Firebase service account (production)
#   FIREBASE_PROJECT_ID_PROD           -> Firebase project ID (production)
#   RENDER_DEPLOY_HOOK_PROD            -> Render Production Deploy Hook URL
#   STAGING_API_URL                    -> https://smarthealth-backend-staging.onrender.com
#   STAGING_WEB_URL                    -> https://smarthealth-staging.vercel.app
#   ADMIN_SERVICE_TOKEN                -> Firebase ID token for nightly SHA-256 audit chain verification
